@using MealPlanner.UI.Models
<MudNavMenu>

    @foreach (var week in Weeks)
    {
        <MudNavGroup Title="@($"Week {week.WeekNumber}")"
                     Expanded="@IsExpanded(week)"
                     ExpandedChanged="@(() => ToggleWeek(week))">

            @if (IsExpanded(week))
            {
                <DayNavigation Week="week" />
            }

        </MudNavGroup>
    }

</MudNavMenu>


@code {
    [Parameter]
    public EventCallback<int> WeekSelected { get; set; }

    private List<CalendarWeek> Weeks = [];

    private int? ExpandedWeek;

    protected override void OnInitialized()
    {
        var today = DateTime.Today;
        var current = ISOWeek.GetWeekOfYear(today);

        Weeks =
        [
            BuildWeek(current - 1),
            BuildWeek(current),
            BuildWeek(current + 1)
        ];
    }


    private CalendarWeek BuildWeek(int weekNumber)
    {
        var year = DateTime.Today.Year;

        var monday =
            ISOWeek.ToDateTime(year, weekNumber, DayOfWeek.Monday);

        return new CalendarWeek
        {
            WeekNumber = weekNumber,
            Days =
                Enumerable.Range(0, 7)
                    .Select(x => monday.AddDays(x))
                    .ToList()
        };
    }


    private bool IsExpanded(CalendarWeek week)
        => ExpandedWeek == week.WeekNumber;


    private async Task ToggleWeek(CalendarWeek week)
    {
        ExpandedWeek = week.WeekNumber;

        await WeekSelected.InvokeAsync(
            week.WeekNumber);
    }
}