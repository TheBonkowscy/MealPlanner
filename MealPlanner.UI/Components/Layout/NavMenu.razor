@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Translations> L

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">@L[TranslationKeys.NavMenu.NavMenuDashboardName]</MudNavLink>
    <MudNavGroup Title="@L[TranslationKeys.NavMenu.NavMenuMenusGroupTitle]" Expanded="false">
        <WeeklyMenuNavigation />
    </MudNavGroup>
    <MudNavLink Href="@RoutingConstants.ShoppingLists.Path">@L[TranslationKeys.NavMenu.NavMenuShoppingListsLink]</MudNavLink>
    <MudNavGroup Title="@L[TranslationKeys.NavMenu.NavMenuEditorsGroupTitle]" Expanded="false">
        <RecipeEditorNavigation />
    </MudNavGroup>
</MudNavMenu>