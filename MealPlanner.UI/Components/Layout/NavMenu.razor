@using Microsoft.Extensions.Localization
@inject IStringLocalizer<Translations> L

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">@L[TranslationKeys.NavMenu.DashboardName]</MudNavLink>
    <MudNavGroup Title="@L[TranslationKeys.NavMenu.MenusGroupTitle]" Expanded="false">
        <WeeklyMenuNavigation />
    </MudNavGroup>
    <MudNavGroup Title="@L[TranslationKeys.NavMenu.EditorsGroupTitle]" Expanded="false">
        <RecipeEditorNavigation />
    </MudNavGroup>
</MudNavMenu>