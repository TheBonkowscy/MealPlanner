@using MealPlanner.Shared.Menus.Responses
@using MealPlanner.UI.Models
@using MealPlanner.UI.Services

@implements IDisposable
@inject IMenuFinder MenuFinder
@inject NavigationManager Navigation
@inject IMenuStateService MenuStateService

<MudNavMenu>
    @foreach (var week in _weeks)
    {
        <MudNavGroup Title="@($"Week {week.WeekNumber} of {week.Year}")"
                     Expanded="@IsExpanded(week)"
                     ExpandedChanged="@(() => SelectWeek(week))"
                     Class="@GetWeekTitleClass(week)">
            
            @if (IsExpanded(week))
            {
                <MudNavMenu Class="ml-4">
                    @foreach (var day in week.Days)
                    {
                        <div class="d-flex align-center justify-space-between @GetDayClass(day.Day)">


                            @if (!_menuExists.GetValueOrDefault(day.Day))
                            {
                                <MudNavLink Href="@(RoutingConstants.Menus.CreateForDate(day.Day))">
                                    @day.Day.ToString("dddd, d MMMM yyyy", _culture)
                                </MudNavLink>
                                <MudIconButton
                                    Icon="@Icons.Material.Filled.Add"
                                    Size="Size.Small"
                                    Color="Color.Primary"
                                    OnClick="@(() => OnMenuCreating(day.Day))" />
                            }
                            else
                            {
                                <MudNavLink Href="@(RoutingConstants.Menus.DetailsForDate(day.Day))">
                                    @day.Day.ToString("dddd, d MMMM yyyy", _culture)
                                </MudNavLink>
                                <MudIconButton
                                    Icon="@(IsToday(day.Day) ? Icons.Material.Filled.Today : Icons.Material.Filled.Assignment)"
                                    Size="Size.Small"
                                    Color="Color.Primary"
                                    OnClick="@(() => OnViewMenu(day.Day))" />
                            }

                        </div>
                    }
                </MudNavMenu>
            }
        </MudNavGroup>
    }
</MudNavMenu>

@code {
    [Parameter]
    public EventCallback<DateOnly> CreateMenu { get; set; }
    
    [Parameter]
    public EventCallback<DateOnly> EditMenu { get; set; }
    
    [Parameter]
    public EventCallback<DateOnly> ViewMenu { get; set; }

    [Parameter]
    public int? SelectedWeek { get; set; }

    [Parameter]
    public EventCallback<int> SelectedWeekChanged { get; set; }

    private readonly CancellationTokenSource _cts = new();
    private readonly CultureInfo _culture = new("pl-PL");

    private static readonly DateOnly Today = DateOnly.FromDateTime(DateTime.Today);

    private List<CalendarWeek> _weeks = [];
    private Dictionary<DateOnly, bool> _menuExists = new();

    protected override async Task OnInitializedAsync()
    {
        // 1. Define range: 6 months back to 6 months forward
        var startDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(-6));
        var endDate = DateOnly.FromDateTime(DateTime.Today.AddMonths(6));

        // Fetch menu data from API
        var response = await MenuFinder.GetRange(startDate, endDate, _cts.Token);

        // Map response items into a fast lookup dictionary
        var existingMenusDict = response.ExistingMenus
            .ToDictionary(x => x.Day, x => x);

        // Track menu existence for the UI button visibility check
        _menuExists = existingMenusDict.ToDictionary(k => k.Key, v => true);

        // 2. Build historically ordered weeks from range
        _weeks = BuildWeeksForRange(startDate, endDate, existingMenusDict);

        // Default selection to current week if none specified
        if (!SelectedWeek.HasValue)
        {
            var currentWeek = _weeks.FirstOrDefault(w => w.Current);
            if (currentWeek != null)
            {
                SelectedWeek = currentWeek.WeekNumber;
            }
        }
        MenuStateService.OnMenuChanged += HandleMenuChanged;
    }

    private void HandleMenuChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private static List<CalendarWeek> BuildWeeksForRange(
        DateOnly start, 
        DateOnly end, 
        Dictionary<DateOnly, ExistingMenuListItem> existingMenus)
    {
        var weeks = new List<CalendarWeek>();

        // Find Monday of the starting date's week
        var currentMonday = DateOnly.FromDateTime(
            ISOWeek.ToDateTime(
                ISOWeek.GetYear(start), 
                ISOWeek.GetWeekOfYear(start), 
                DayOfWeek.Monday)); 

        var time = TimeOnly.FromDateTime(DateTime.Today);
        while (currentMonday <= end)
        {
            var weekNumber = ISOWeek.GetWeekOfYear(currentMonday);
            var year = ISOWeek.GetYear(currentMonday);

            var days = Enumerable.Range(0, 7).Select(i =>
            {
                var date = DateOnly.FromDateTime(currentMonday.AddDays(i).ToDateTime(time));
                existingMenus.TryGetValue(date, out var menu);

                return new CalendarDay
                {
                    Day = date,
                    Id = menu?.Id,
                    Exists = menu is not null
                };
            }).ToList();

            weeks.Add(new CalendarWeek
            {
                WeekNumber = weekNumber,
                Year = year,
                Days = days
            });

            currentMonday = currentMonday.AddDays(7);
        }

        return weeks;
    }

    private bool IsExpanded(CalendarWeek week)
    {
        return SelectedWeek == week.WeekNumber;
    }

    private async Task SelectWeek(CalendarWeek week)
    {
        SelectedWeek = week.WeekNumber;
        await SelectedWeekChanged.InvokeAsync(week.WeekNumber);
    }

    private static string GetWeekTitleClass(CalendarWeek week)
    {
        return week.Current ? "current-week-title" : string.Empty;
    }

    private static string GetDayClass(DateOnly day)
    {
        return day == DateOnly.FromDateTime(DateTime.Today) ? "today-day" : string.Empty;
    }
    
    private async Task OnMenuCreating(DateOnly day)
    {
        // Execute parameter callback for parent listeners
        if (CreateMenu.HasDelegate)
        {
            await CreateMenu.InvokeAsync(day);
        }

        // Perform navigation
        Navigation.NavigateTo(RoutingConstants.Menus.CreateForDate(day));
    }
    
    private async Task OnViewMenu(DateOnly day)
    {
        // Execute parameter callback for parent listeners
        if (ViewMenu.HasDelegate)
        {
            await ViewMenu.InvokeAsync(day);
        }

        // Perform navigation
        Navigation.NavigateTo(RoutingConstants.Menus.DetailsForDate(day));
    }
    
    private static bool IsToday(DateOnly date)
    {
        return date == Today; 
    }

    public void Dispose()
    {
        MenuStateService.OnMenuChanged -= HandleMenuChanged;
        
        _cts.Cancel();
        _cts.Dispose();
    }
}