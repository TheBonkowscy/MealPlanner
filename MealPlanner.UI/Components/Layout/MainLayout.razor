@inherits LayoutComponentBase
@using MealPlanner.UI.Services
@implements IDisposable
@inject AppBarService AppBarService
@inject NavigationManager Navigation

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" 
                       Color="Color.Inherit" 
                       Edge="Edge.Start" 
                       OnClick="@(_ => DrawerToggle())" />
        <MudSpacer/>
        <MudText Typo="Typo.h5">@AppBarService.Title</MudText>
    
        <MudSpacer/>
        
        @foreach (var action in AppBarService.Actions)
        {
            <MudTooltip Text="@action.Tooltip">
                <MudIconButton
                    Color="Color.Inherit"
                    Icon="@action.Icon"
                    OnClick="@action.OnClick" />
            </MudTooltip>
        }

        <MudTooltip Text="Go to Today">
            <MudIconButton
                Color="Color.Inherit"
                Icon="@Icons.Material.Filled.Today"
                OnClick="GoToToday" />
        </MudTooltip>
    </MudAppBar>

    <MudDrawer @bind-Open="@_drawerOpen">
        <NavMenu/>
    </MudDrawer>
    
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private string _title = "Meal Planner";
    private bool _drawerOpen = true;

    protected override void OnInitialized()
    {
        AppBarService.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        AppBarService.OnChange -= StateHasChanged;
    }

    private void DrawerToggle() => _drawerOpen = !_drawerOpen;

    private void GoToToday()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        Navigation.NavigateTo(RoutingConstants.Menus.DetailsForDate(today));
    }
}