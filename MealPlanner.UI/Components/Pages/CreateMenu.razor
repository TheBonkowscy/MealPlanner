@page "/menus/create/{Date:datetime}"
@using MealPlanner.Shared.Menus.Requests
@implements IDisposable

@inject IMenuCreator MenuCreator
@inject IMealFinder MealFinder
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<h3>@($"Tworzenie nowego menu na dzień {Date:dd.MM.yyyy}")</h3>

<MudPaper Class="pa-6 ma-4" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-4">Posiłki w tym dniu (przeciągnij, aby zmienić kolejność)</MudText>

    <MudDropContainer @ref="_container"
                      T="MenuItemDto" 
                      Items="_menuItems" 
                      ItemsSelector="@((item, dropzone) => item.ZoneIdentifier == dropzone)" 
                      ItemDropped="ItemDropped" 
                      Class="d-flex flex-column flex-grow-1">
        <ChildContent>
            <MudDropZone T="MenuItemDto" 
                         Identifier="DayMenuZone" 
                         AllowReorder="true" 
                         Class="rounded mud-background-gray pa-4 min-height-200">
                <ItemRenderer>
                    <MudPaper Class="pa-3 my-2 d-flex justify-space-between align-center" Elevation="2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.DragHandle" Class="mr-3 cursor-grab" />
                            <MudText Typo="Typo.body1">@context.Name</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       OnClick="@(() => RemoveMeal(context))" />
                    </MudPaper>
                </ItemRenderer>
            </MudDropZone>
        </ChildContent>
    </MudDropContainer>

    <MudPaper Class="pa-4 mt-4 mud-theme-light" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Dodaj nowy posiłek do menu:</MudText>
        <MudAutocomplete T="string"
                         Label="Szukaj potrawy..."
                         Value="_selectedMeal"
                         ValueChanged="OnMealSelected"
                         SearchFunc="SearchMealsAsync"
                         ResetValueOnSelected="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         DebounceInterval="300" 
                         MinCharacters="2" />
    </MudPaper>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Class="mt-6"
               OnClick="SaveMenuAsync">
        Utwórz menu
    </MudButton>
</MudPaper>

@code {
    [Parameter] public DateTime Date { get; set; }

    private MudDropContainer<MenuItemDto>? _container;
    private readonly List<MenuItemDto> _menuItems = [];
    private string? _selectedMeal;
    private readonly CancellationTokenSource _cts = new();

    public class MenuItemDto
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Name { get; set; } = string.Empty;
        public string ZoneIdentifier { get; set; } = "DayMenuZone";
        public int Order { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        _menuItems.Clear();
    }

    private void ItemDropped(MudItemDropInfo<MenuItemDto> dropItem)
    {
        if (dropItem?.Item is null) return;

        // 1. Usuwamy przeciągnięty element
        _menuItems.Remove(dropItem.Item);

        // 2. Wyznaczamy i zabezpieczamy indeks docelowy
        var targetIndex = dropItem.IndexInZone;
        if (targetIndex < 0) targetIndex = 0;
        if (targetIndex > _menuItems.Count) targetIndex = _menuItems.Count;

        // 3. Wstawiamy go na właściwą pozycję
        _menuItems.Insert(targetIndex, dropItem.Item);

        // 4. Odświeżamy indeksy Order
        for (var i = 0; i < _menuItems.Count; i++)
        {
            _menuItems[i].Order = i;
        }

        _container?.Refresh();
    }

    private async Task<IEnumerable<string>> SearchMealsAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value)) return Array.Empty<string>();
        return await FetchMealsFromApiAsync(value, token);
    }

    private void OnMealSelected(string selectedMeal)
    {
        if (string.IsNullOrWhiteSpace(selectedMeal)) return;

        _menuItems.Add(new MenuItemDto
        {
            Name = selectedMeal,
            Order = _menuItems.Count,
            ZoneIdentifier = "DayMenuZone"
        });

        _selectedMeal = string.Empty;
        _container?.Refresh();
    }

    private void RemoveMeal(MenuItemDto item)
    {
        _menuItems.Remove(item);
        for (int i = 0; i < _menuItems.Count; i++)
        {
            _menuItems[i].Order = i;
        }
        _container?.Refresh();
    }

    private async Task SaveMenuAsync()
    {
        if (!_menuItems.Any())
        {
            Snackbar.Add("Dodaj co najmniej jeden posiłek!", Severity.Warning);
            return;
        }

        var orderedMeals = _menuItems.Select(x => x.Name).ToArray();

        var request = new CreateMenuRequest(DateOnly.FromDateTime(Date), orderedMeals);
        var response = await MenuCreator.CreateMenu(request, _cts.Token);
        Snackbar.Add("Utworzono nowe menu!", Severity.Success);
        
        Navigation.NavigateTo(RoutingConstants.Menus.DetailsForDate(response.Date));
    }

    #region API Calls

    private async Task<IEnumerable<string>> FetchMealsFromApiAsync(string? query, CancellationToken token)
    {
        var results = await MealFinder.Get(query, token);

        return results.Meals.Select(x => x.Name);
    }
    #endregion

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}