@page "/menus/week/{Date:datetime}"
@using MealPlanner.Client.Meals
@using MealPlanner.Client.Menus
@using MealPlanner.Client.Models
@using MealPlanner.Shared.Menus.Requests
@using MealPlanner.Shared.Menus.Responses
@using MealPlanner.UI.Models
@using MealPlanner.UI.Services
@using Microsoft.Extensions.Localization
@implements IDisposable
@inject IFindMenus FindMenus
@inject IUpdateMeals MealUpdater
@inject IDeleteMeals MealDeleter
@inject AppBarService AppBarService
@inject MealMapper MealMapper
@inject ISnackbar Snackbar
@inject ILogger<WeekMenu> Logger
@inject TimeProvider Clock
@inject IStringLocalizer<Translations> L

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <div class="week-header">
        <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuPreviousWeekButtonTitle]">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                           Href="@RoutingConstants.Menus.WeekFor(WeekNavigation.Previous(_weekStart))"
                           aria-label="@L[TranslationKeys.WeekMenu.WeekMenuPreviousWeekButtonTitle]" />
        </MudTooltip>

        <div class="week-title">
            <MudText Typo="Typo.h5">@WeekTitle</MudText>
            <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@WeekRange</MudText>
        </div>

        <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuNextWeekButtonTitle]">
            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                           Href="@RoutingConstants.Menus.WeekFor(WeekNavigation.Next(_weekStart))"
                           aria-label="@L[TranslationKeys.WeekMenu.WeekMenuNextWeekButtonTitle]" />
        </MudTooltip>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_failed)
    {
        <MudAlert Severity="Severity.Error">@L[TranslationKeys.WeekMenu.WeekMenuLoadErrorTitle]</MudAlert>
    }
    else
    {
        <MudDropContainer @ref="_container"
                          T="WeekMeal"
                          Items="_items"
                          ItemsSelector="@((meal, zone) => meal.ZoneIdentifier == zone)"
                          ItemDropped="ItemDroppedAsync"
                          ItemDisabled="@(_ => _busy)">
            <div class="week-grid">
                @foreach (var day in _days)
                {
                    <section class="week-day @(day.Date == _today ? "today" : string.Empty)"
                             aria-label="@day.Date.ToString("D", CultureInfo.CurrentUICulture)">
                        <header class="week-day-header">
                            <div class="day-name">@day.Date.ToString("dddd", CultureInfo.CurrentUICulture)</div>
                            <div class="day-date">@day.Date.ToString("d MMM", CultureInfo.CurrentUICulture)</div>
                        </header>

                        @if (day.Meals.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                @L[TranslationKeys.WeekMenu.WeekMenuNoMealsTitle]
                            </MudText>
                        }

                        <MudDropZone T="WeekMeal"
                                     Identifier="@day.Date.ToString("O", CultureInfo.InvariantCulture)"
                                     AllowReorder="true"
                                     CanDrop="@(meal => meal.Date == day.Date)"
                                     ApplyDropClassesOnDragStarted="true">
                            <ItemRenderer Context="meal">
                                <div class="meal">
                                    <MudLink Href="@RoutingConstants.Recipes.DetailsFor(meal.RecipeId)">@meal.Name</MudLink>
                                    <div class="meal-actions">
                                        <MudNumericField T="int"
                                                         @key="_reloadVersion"
                                                         Value="meal.Servings"
                                                         ValueChanged="@(value => ChangeServingsAsync(meal, value))"
                                                         Min="1"
                                                         Label="@L[TranslationKeys.WeekMenu.WeekMenuServingsLabel]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Disabled="_busy" />
                                        <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuDeleteMealButtonTitle]">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           Disabled="_busy"
                                                           OnClick="@(() => DeleteMealAsync(meal))"
                                                           aria-label="@L[TranslationKeys.WeekMenu.WeekMenuDeleteMealButtonTitle]" />
                                        </MudTooltip>
                                    </div>
                                </div>
                            </ItemRenderer>
                        </MudDropZone>
                    </section>
                }
            </div>
        </MudDropContainer>
    }
</MudContainer>

@code {
    [Parameter] public DateTime Date { get; set; }

    private readonly CancellationTokenSource _cts = new();

    private DateOnly _weekStart;
    private DateOnly _today;
    private MudDropContainer<WeekMeal>? _container;
    private List<WeekDay> _days = [];
    private List<WeekMeal> _items = [];
    private bool _loading = true;
    private bool _failed;
    private bool _busy;
    private bool _refreshContainerAfterRender;
    private int _reloadVersion;

    private string WeekTitle =>
        L[TranslationKeys.WeekMenu.WeekMenuTitle, ISOWeek.GetWeekOfYear(_weekStart.ToDateTime(TimeOnly.MinValue))];

    private string WeekRange =>
        $"{_weekStart.ToString("d MMM", CultureInfo.CurrentUICulture)} – {_weekStart.AddDays(6).ToString("d MMM yyyy", CultureInfo.CurrentUICulture)}";

    protected override async Task OnParametersSetAsync()
    {
        var requestedWeek = WeekNavigation.StartOf(DateOnly.FromDateTime(Date));

        _weekStart = requestedWeek;
        _today = DateOnly.FromDateTime(Clock.GetLocalNow().Date);
        _loading = true;
        AppBarService.SetTitle($"{WeekTitle} • {WeekRange}");

        var week = await FindMenus.GetWeek(requestedWeek, _cts.Token);

        if (requestedWeek != _weekStart)
        {
            return;
        }

        ApplyWeek(week);
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_refreshContainerAfterRender)
        {
            _refreshContainerAfterRender = false;
            _container?.Refresh();
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();
    }

    private void ApplyWeek(GetWeekResponse week)
    {
        _reloadVersion++;
        _failed = week.Days.Count == 0;
        _days = [.. week.Days
            .OrderBy(x => x.Date)
            .Select(x => new WeekDay(x.Date, [.. MealMapper.MapMeals(x.Meals)
                .Select(meal => new WeekMeal(x.Date, meal.Id, meal.Name, meal.Servings))]))];
        _items = [.. _days.SelectMany(day => day.Meals)];
    }

    private async Task ReloadWeekAsync(CancellationToken token)
    {
        var weekStart = _weekStart;

        var week = await FindMenus.GetWeek(weekStart, token);

        if (weekStart != _weekStart)
        {
            return;
        }

        ApplyWeek(week);
        _refreshContainerAfterRender = true;
    }

    private async Task TryReloadWeekAsync(CancellationToken token)
    {
        try
        {
            await ReloadWeekAsync(token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or HttpRequestException)
        {
        }
    }

    private async Task RunGestureAsync(Func<CancellationToken, Task<ApiResult>> gesture)
    {
        if (_busy)
        {
            return;
        }

        var token = _cts.Token;

        _busy = true;
        StateHasChanged();

        try
        {
            var result = await gesture(token);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error!.Message, Severity.Error);
            }

            await ReloadWeekAsync(token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _refreshContainerAfterRender = true;
            await TryReloadWeekAsync(token);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ItemDroppedAsync(MudItemDropInfo<WeekMeal> drop)
    {
        if (drop.Item is null)
        {
            return Task.CompletedTask;
        }

        var action = DecideDrop(drop.Item, drop.DropzoneIdentifier, drop.IndexInZone);

        if (action is WeekDropAction.ReorderMeal reorder)
        {
            _ = ReorderAsync(reorder);
        }
        else
        {
            _container?.Refresh();
        }

        return Task.CompletedTask;
    }

    private WeekDropAction DecideDrop(WeekMeal meal, string zoneIdentifier, int dropIndex)
    {
        if (!DateOnly.TryParse(zoneIdentifier, CultureInfo.InvariantCulture, DateTimeStyles.None, out var targetDay))
        {
            return WeekDropAction.None;
        }

        var recipeIds = _days
            .Where(day => day.Date == meal.Date)
            .SelectMany(day => day.Meals)
            .Select(x => x.RecipeId)
            .ToList();

        return WeekDropDecision.Decide(meal.Date, meal.RecipeId, targetDay, dropIndex, recipeIds);
    }

    private async Task ReorderAsync(WeekDropAction.ReorderMeal reorder)
    {
        var weekToken = _cts.Token;

        await Task.Yield();

        try
        {
            await RunGestureAsync(token =>
                MealUpdater.Update(reorder.Day, reorder.RecipeId, new UpdateMealRequest(null, reorder.Position), token));
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Reordering meal {RecipeId} on {Day} failed", reorder.RecipeId, reorder.Day);
            Snackbar.Add(L[TranslationKeys.WeekMenu.WeekMenuUnexpectedErrorTitle], Severity.Error);
            _refreshContainerAfterRender = true;

            try
            {
                await TryReloadWeekAsync(weekToken);
            }
            catch (Exception reloadException)
            {
                Logger.LogError(reloadException, "Reloading the week after a failed reorder failed");
            }
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ChangeServingsAsync(WeekMeal meal, int servings) =>
        RunGestureAsync(token => MealUpdater.Update(meal.Date, meal.RecipeId, new UpdateMealRequest(servings, null), token));

    private Task DeleteMealAsync(WeekMeal meal) =>
        RunGestureAsync(token => MealDeleter.Delete(meal.Date, meal.RecipeId, token));

    private sealed record WeekDay(DateOnly Date, List<WeekMeal> Meals);
}
