@page "/menus/week/{Date:datetime}"
@using MealPlanner.Client.Meals
@using MealPlanner.Client.Menus
@using MealPlanner.Client.Models
@using MealPlanner.Client.Recipes
@using MealPlanner.Shared.Menus.Meals
@using MealPlanner.Shared.Menus.Requests
@using MealPlanner.Shared.Menus.Responses
@using MealPlanner.UI.Models
@using MealPlanner.UI.Services
@using Microsoft.Extensions.Localization
@implements IAsyncDisposable
@inject IFindMenus FindMenus
@inject IUpdateMeals MealUpdater
@inject IAddMeals MealAdder
@inject IDeleteMeals MealDeleter
@inject ITransferMeals MealTransferer
@inject IFindRecipes FindRecipes
@inject AppBarService AppBarService
@inject MealMapper MealMapper
@inject ISnackbar Snackbar
@inject ILogger<WeekMenu> Logger
@inject TimeProvider Clock
@inject IStringLocalizer<Translations> L
@inject IJSRuntime JS

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mt-4">
    <div class="week-header">
        <div class="week-nav">
            <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuPreviousWeekButtonTitle]">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                               Href="@RoutingConstants.Menus.WeekFor(WeekNavigation.Previous(_weekStart))"
                               aria-label="@L[TranslationKeys.WeekMenu.WeekMenuPreviousWeekButtonTitle]" />
            </MudTooltip>

            <div class="week-title">
                <MudText Typo="Typo.h5">@WeekTitle</MudText>
                <MudText Typo="Typo.subtitle2" Class="mud-text-secondary">@WeekRange</MudText>
            </div>

            <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuNextWeekButtonTitle]">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                               Href="@RoutingConstants.Menus.WeekFor(WeekNavigation.Next(_weekStart))"
                               aria-label="@L[TranslationKeys.WeekMenu.WeekMenuNextWeekButtonTitle]" />
            </MudTooltip>
        </div>

        <div class="copy-mode">
            <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuCopyModeTooltip]">
                <MudSwitch T="bool"
                           @bind-Value="_copyMode"
                           Color="Color.Primary"
                           Label="@L[TranslationKeys.WeekMenu.WeekMenuCopyModeLabel]" />
            </MudTooltip>
        </div>
    </div>

    @if (_loading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
    }
    else if (_failed)
    {
        <MudAlert Severity="Severity.Error">@L[TranslationKeys.WeekMenu.WeekMenuLoadErrorTitle]</MudAlert>
    }
    else
    {
        <MudDropContainer @ref="_container"
                          T="WeekDragItem"
                          Items="_items"
                          ItemsSelector="@((item, zone) => item.ZoneIdentifier == zone)"
                          ItemDropped="ItemDroppedAsync"
                          ItemDisabled="@(_ => _busy)">
            <div class="week-layout">
                <div class="week-grid">
                    @foreach (var day in _days)
                    {
                        <section class="week-day @(day.Date == _today ? "today" : string.Empty)"
                                 aria-label="@day.Date.ToString("D", CultureInfo.CurrentUICulture)">
                            <header class="week-day-header">
                                <div class="day-name">@day.Date.ToString("dddd", CultureInfo.CurrentUICulture)</div>
                                <div class="day-date">@day.Date.ToString("d MMM", CultureInfo.CurrentUICulture)</div>
                            </header>

                            @if (day.Meals.Count == 0)
                            {
                                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                    @L[TranslationKeys.WeekMenu.WeekMenuNoMealsTitle]
                                </MudText>
                            }

                            <MudDropZone T="WeekDragItem"
                                         Identifier="@day.Date.ToString("O", CultureInfo.InvariantCulture)"
                                         AllowReorder="true"
                                         ApplyDropClassesOnDragStarted="true">
                                <ItemRenderer Context="item">
                                    @if (item is WeekMeal meal)
                                    {
                                        <div class="meal">
                                            <MudLink Href="@RoutingConstants.Recipes.DetailsFor(meal.RecipeId)">@meal.Name</MudLink>
                                            <div class="meal-actions">
                                                <MudNumericField T="int"
                                                                 @key="_reloadVersion"
                                                                 Value="meal.Servings"
                                                                 ValueChanged="@(value => ChangeServingsAsync(meal, value))"
                                                                 Min="1"
                                                                 Label="@L[TranslationKeys.WeekMenu.WeekMenuServingsLabel]"
                                                                 Variant="Variant.Outlined"
                                                                 Margin="Margin.Dense"
                                                                 Disabled="_busy" />
                                                <MudTooltip Text="@L[TranslationKeys.WeekMenu.WeekMenuDeleteMealButtonTitle]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                                   Color="Color.Error"
                                                                   Size="Size.Small"
                                                                   Disabled="_busy"
                                                                   OnClick="@(() => DeleteMealAsync(meal))"
                                                                   aria-label="@L[TranslationKeys.WeekMenu.WeekMenuDeleteMealButtonTitle]" />
                                                </MudTooltip>
                                            </div>
                                        </div>
                                    }
                                </ItemRenderer>
                            </MudDropZone>
                        </section>
                    }
                </div>

                <aside class="week-panel" aria-label="@L[TranslationKeys.WeekMenu.WeekMenuRecipePanelTitle]">
                    <MudText Typo="Typo.h6" Class="mb-2">@L[TranslationKeys.WeekMenu.WeekMenuRecipePanelTitle]</MudText>

                    <MudTextField T="string"
                                  Value="_search"
                                  ValueChanged="SearchRecipesAsync"
                                  Immediate="true"
                                  DebounceInterval="300"
                                  Label="@L[TranslationKeys.WeekMenu.WeekMenuRecipeSearchLabel]"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Adornment="Adornment.Start"
                                  AdornmentIcon="@Icons.Material.Filled.Search"
                                  Clearable="true" />

                    @if (_panelRecipes.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">
                            @L[TranslationKeys.WeekMenu.WeekMenuNoRecipesTitle]
                        </MudText>
                    }

                    <MudDropZone T="WeekDragItem"
                                 Identifier="@PanelRecipe.Zone"
                                 CanDrop="@(_ => false)">
                        <ItemRenderer Context="item">
                            @if (item is PanelRecipe recipe)
                            {
                                <div class="panel-recipe">@recipe.Name</div>
                            }
                        </ItemRenderer>
                    </MudDropZone>
                </aside>
            </div>
        </MudDropContainer>
    }
</MudContainer>

@code {
    [Parameter] public DateTime Date { get; set; }

    private readonly CancellationTokenSource _cts = new();

    private DateOnly _weekStart;
    private DateOnly _today;
    private MudDropContainer<WeekDragItem>? _container;
    private IJSObjectReference? _dragModule;
    private List<WeekDay> _days = [];
    private List<WeekDragItem> _items = [];
    private List<PanelRecipe> _panelRecipes = [];
    private string _search = string.Empty;
    private bool _loading = true;
    private bool _failed;
    private bool _busy;
    private bool _copyMode;
    private bool _refreshContainerAfterRender;
    private int _reloadVersion;

    private string WeekTitle =>
        L[TranslationKeys.WeekMenu.WeekMenuTitle, ISOWeek.GetWeekOfYear(_weekStart.ToDateTime(TimeOnly.MinValue))];

    private string WeekRange =>
        $"{_weekStart.ToString("d MMM", CultureInfo.CurrentUICulture)} – {_weekStart.AddDays(6).ToString("d MMM yyyy", CultureInfo.CurrentUICulture)}";

    protected override void OnInitialized() => _ = LoadRecipesAsync();

    protected override async Task OnParametersSetAsync()
    {
        var requestedWeek = WeekNavigation.StartOf(DateOnly.FromDateTime(Date));

        _weekStart = requestedWeek;
        _today = DateOnly.FromDateTime(Clock.GetLocalNow().Date);
        _loading = true;
        AppBarService.SetTitle($"{WeekTitle} • {WeekRange}");

        var week = await FindMenus.GetWeek(requestedWeek, _cts.Token);

        if (requestedWeek != _weekStart)
        {
            return;
        }

        ApplyWeek(week);
        _loading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (_refreshContainerAfterRender)
        {
            _refreshContainerAfterRender = false;
            _container?.Refresh();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Pages/Menus/WeekMenu.razor.js");
            await module.InvokeVoidAsync("start");

            if (_cts.IsCancellationRequested)
            {
                await ReleaseDragModuleAsync(module);
                return;
            }

            _dragModule = module;
        }
        catch (JSException ex)
        {
            Logger.LogError(ex, "Loading the drag modifier module failed");
        }
        catch (Exception ex) when (ex is JSDisconnectedException or OperationCanceledException)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();

        if (_dragModule is not null)
        {
            await ReleaseDragModuleAsync(_dragModule);
        }
    }

    private static async Task ReleaseDragModuleAsync(IJSObjectReference module)
    {
        try
        {
            await module.InvokeVoidAsync("stop");
            await module.DisposeAsync();
        }
        catch (Exception ex) when (ex is JSDisconnectedException or JSException or OperationCanceledException)
        {
        }
    }

    private void ApplyWeek(GetWeekResponse week)
    {
        _reloadVersion++;
        _failed = week.Days.Count == 0;
        _days = [.. week.Days
            .OrderBy(x => x.Date)
            .Select(x => new WeekDay(x.Date, [.. MealMapper.MapMeals(x.Meals)
                .Select(meal => new WeekMeal(x.Date, meal.Id, meal.Name, meal.Servings))]))];
        RebuildItems();
    }

    private void RebuildItems()
    {
        _items = [.. _days.SelectMany(day => day.Meals), .. _panelRecipes];
    }

    private async Task LoadRecipesAsync()
    {
        await SearchRecipesAsync(null);

        if (!_cts.IsCancellationRequested)
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task SearchRecipesAsync(string? query)
    {
        _search = query ?? string.Empty;
        var requested = _search.Trim();

        try
        {
            var response = await FindRecipes.Get(requested, _cts.Token);

            if (_search.Trim() != requested)
            {
                return;
            }

            _panelRecipes = MealMapper.MapPanelRecipes(response);
            RebuildItems();
            _refreshContainerAfterRender = true;
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Searching recipes for the panel failed");
            Snackbar.Add(L[TranslationKeys.WeekMenu.WeekMenuUnexpectedErrorTitle], Severity.Error);
        }
    }

    private async Task ReloadWeekAsync(CancellationToken token)
    {
        var weekStart = _weekStart;

        var week = await FindMenus.GetWeek(weekStart, token);

        if (weekStart != _weekStart)
        {
            return;
        }

        ApplyWeek(week);
        _refreshContainerAfterRender = true;
    }

    private async Task TryReloadWeekAsync(CancellationToken token)
    {
        try
        {
            await ReloadWeekAsync(token);
        }
        catch (Exception ex) when (ex is OperationCanceledException or HttpRequestException)
        {
        }
    }

    private async Task RunGestureAsync(Func<CancellationToken, Task<ApiResult>> gesture)
    {
        if (_busy)
        {
            return;
        }

        var token = _cts.Token;

        _busy = true;
        StateHasChanged();

        try
        {
            var result = await gesture(token);

            if (!result.IsSuccess)
            {
                Snackbar.Add(result.Error!.Message, Severity.Error);
            }

            await ReloadWeekAsync(token);
        }
        catch (OperationCanceledException)
        {
        }
        catch (HttpRequestException ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
            _refreshContainerAfterRender = true;
            await TryReloadWeekAsync(token);
        }
        finally
        {
            _busy = false;
        }
    }

    private Task ItemDroppedAsync(MudItemDropInfo<WeekDragItem> drop)
    {
        if (!_copyMode && drop.Item is WeekMeal dragged && IsOtherDay(dragged, drop.DropzoneIdentifier))
        {
            _ = DropOnOtherDayAsync(dragged, drop.DropzoneIdentifier, drop.IndexInZone);
            return Task.CompletedTask;
        }

        var action = drop.Item switch
        {
            WeekMeal meal => DecideMealDrop(meal, drop.DropzoneIdentifier, drop.IndexInZone, _copyMode),
            PanelRecipe recipe => DecideRecipeDrop(recipe, drop.DropzoneIdentifier, drop.IndexInZone),
            _ => WeekDropAction.None
        };

        ApplyDropAction(action);

        return Task.CompletedTask;
    }

    private async Task DropOnOtherDayAsync(WeekMeal meal, string zoneIdentifier, int dropIndex)
    {
        var shiftHeld = await ReadShiftHeldAsync();

        if (_cts.IsCancellationRequested)
        {
            return;
        }

        if (shiftHeld is null)
        {
            _container?.Refresh();
            return;
        }

        ApplyDropAction(DecideMealDrop(meal, zoneIdentifier, dropIndex, shiftHeld.Value));
    }

    private void ApplyDropAction(WeekDropAction action)
    {
        switch (action)
        {
            case WeekDropAction.ReorderMeal reorder:
                _ = ReorderAsync(reorder);
                break;
            case WeekDropAction.AddMeal add:
                _ = AddMealAsync(add);
                break;
            case WeekDropAction.TransferMeal transfer:
                _ = TransferAsync(transfer);
                break;
            default:
                _container?.Refresh();
                break;
        }
    }

    private async Task<bool?> ReadShiftHeldAsync()
    {
        try
        {
            if (_dragModule is not null)
            {
                return await _dragModule.InvokeAsync<bool>("wasShiftHeld");
            }

            Logger.LogError("The drag modifier module is not loaded");
        }
        catch (Exception ex) when (ex is JSException or JSDisconnectedException or OperationCanceledException)
        {
            Logger.LogError(ex, "Reading the Shift key state failed");
        }

        Snackbar.Add(L[TranslationKeys.WeekMenu.WeekMenuUnexpectedErrorTitle], Severity.Error);
        return null;
    }

    private static bool IsOtherDay(WeekMeal meal, string zoneIdentifier) =>
        TryParseDay(zoneIdentifier, out var targetDay) && targetDay != meal.Date;

    private WeekDropAction DecideMealDrop(WeekMeal meal, string zoneIdentifier, int dropIndex, bool copy)
    {
        if (!TryParseDay(zoneIdentifier, out var targetDay))
        {
            return WeekDropAction.None;
        }

        return targetDay == meal.Date
            ? WeekDropDecision.Decide(meal.Date, meal.RecipeId, targetDay, dropIndex, RecipeIdsOf(meal.Date))
            : WeekDropDecision.DecideTransfer(meal.Date, meal.RecipeId, targetDay, dropIndex, copy, RecipeIdsOf(targetDay));
    }

    private WeekDropAction DecideRecipeDrop(PanelRecipe recipe, string zoneIdentifier, int dropIndex) =>
        TryParseDay(zoneIdentifier, out var targetDay)
            ? WeekDropDecision.DecideAdd(recipe.RecipeId, recipe.Servings, targetDay, dropIndex, RecipeIdsOf(targetDay))
            : WeekDropAction.None;

    private static bool TryParseDay(string zoneIdentifier, out DateOnly day) =>
        DateOnly.TryParse(zoneIdentifier, CultureInfo.InvariantCulture, DateTimeStyles.None, out day);

    private List<int> RecipeIdsOf(DateOnly day) =>
        [.. _days
            .Where(weekDay => weekDay.Date == day)
            .SelectMany(weekDay => weekDay.Meals)
            .Select(meal => meal.RecipeId)];

    private Task ReorderAsync(WeekDropAction.ReorderMeal reorder) =>
        RunDropAsync(
            token => MealUpdater.Update(reorder.Day, reorder.RecipeId, new UpdateMealRequest(null, reorder.Position), token),
            $"Reordering meal {reorder.RecipeId} on {reorder.Day}");

    private Task AddMealAsync(WeekDropAction.AddMeal add) =>
        RunDropAsync(
            token => MealAdder.Add(add.Day, new CreateMealRequest(add.RecipeId, add.Position, add.Servings), token),
            $"Adding recipe {add.RecipeId} to {add.Day}");

    private Task TransferAsync(WeekDropAction.TransferMeal transfer) =>
        RunDropAsync(
            token => MealTransferer.Transfer(
                transfer.SourceDay,
                transfer.RecipeId,
                new TransferMealRequest(transfer.TargetDay, transfer.Position, transfer.Mode),
                token),
            $"Transferring meal {transfer.RecipeId} from {transfer.SourceDay} to {transfer.TargetDay}");

    private async Task RunDropAsync(Func<CancellationToken, Task<ApiResult>> gesture, string description)
    {
        var weekToken = _cts.Token;

        await Task.Yield();

        try
        {
            await RunGestureAsync(gesture);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "{Description} failed", description);
            Snackbar.Add(L[TranslationKeys.WeekMenu.WeekMenuUnexpectedErrorTitle], Severity.Error);
            _refreshContainerAfterRender = true;

            try
            {
                await TryReloadWeekAsync(weekToken);
            }
            catch (Exception reloadException)
            {
                Logger.LogError(reloadException, "Reloading the week after a failed {Description} failed", description);
            }
        }
        finally
        {
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task ChangeServingsAsync(WeekMeal meal, int servings) =>
        RunGestureAsync(token => MealUpdater.Update(meal.Date, meal.RecipeId, new UpdateMealRequest(servings, null), token));

    private Task DeleteMealAsync(WeekMeal meal) =>
        RunGestureAsync(token => MealDeleter.Delete(meal.Date, meal.RecipeId, token));

    private sealed record WeekDay(DateOnly Date, List<WeekMeal> Meals);
}
