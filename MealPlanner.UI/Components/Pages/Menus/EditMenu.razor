@page "/menus/edit/{Date:datetime}"
@using MealPlanner.Services.Menus
@using MealPlanner.Shared.Menus.Requests
@using MealPlanner.UI.Models
@using MealPlanner.UI.Services
@inherits ComponentBase
@inject IUpdateMenus MenusUpdater
@inject IFindMenus FindMenus
@inject IDeleteMenus MenusDeleter
@inject IFindRecipes FindRecipes
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject AppBarService AppBarService
@inject MealMapper MealMapper
@inject IDialogService DialogService

<h3>@($"Edycja menu na dzień {Date:dd.MM.yyyy}")</h3>

<MudPaper Class="pa-6 ma-4" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-4">Przeciągnij, aby zmienić kolejność posiłków</MudText>

    <MudDropContainer @ref="_container"
                      T="MealDto" 
                      Items="_meals" 
                      ItemsSelector="@((item, dropzone) => item.ZoneIdentifier == dropzone)" 
                      ItemDropped="ItemDropped" 
                      Class="d-flex flex-column flex-grow-1">
        <ChildContent>
            <MudDropZone T="MealDto" 
                         Identifier="DayMenuZone" 
                         AllowReorder="true" 
                         Class="rounded mud-background-gray pa-4 min-height-200">
                <ItemRenderer>
                    <MudPaper Class="pa-3 my-2 d-flex justify-space-between align-center" Elevation="2">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.DragHandle" Class="mr-3 cursor-grab" />
                            <MudText Typo="Typo.body1">@context.Name</MudText>
                        </div>
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                       Color="Color.Error" 
                                       Size="Size.Small" 
                                       OnClick="@(() => RemoveMeal(context))" />
                    </MudPaper>
                </ItemRenderer>
            </MudDropZone>
        </ChildContent>
    </MudDropContainer>

    <MudPaper Class="pa-4 mt-4 mud-theme-light" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Dodaj nowy posiłek do menu:</MudText>
        <MudAutocomplete T="string"
                         Label="Szukaj potrawy..."
                         Value="_selectedMeal"
                         ValueChanged="OnMealSelected"
                         SearchFunc="SearchRecipesAsync"
                         ResetValueOnSelected="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         DebounceInterval="300" 
                         MinCharacters="2" />
    </MudPaper>

    <MudButton Variant="Variant.Filled" 
               Color="Color.Primary" 
               StartIcon="@Icons.Material.Filled.Save"
               Class="mt-6" 
               OnClick="SaveMenuAsync">
        Zapisz zmiany
    </MudButton>
</MudPaper>

@code {
    [Parameter] public DateTime Date { get; set; }
    
    private readonly CultureInfo _culture =
        new("pl-PL");

    private MudDropContainer<MealDto>? _container;
    private List<MealDto> _meals = [];
    private string? _selectedMeal;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        _meals.Clear();
        
        var formattedTitle = $"Week {ISOWeek.GetWeekOfYear(Date)} • {Date:dddd, d MMMM yyyy} • \u270F";
        AppBarService.SetTitle(formattedTitle);
    
        _meals = await FetchMenuForDateAsync(Date);
        
        AppBarService.SetActions(new AppBarAction
        {
            Icon = Icons.Material.Filled.Undo,
            Tooltip = "Powrót do szczegółów",
            OnClick = EventCallback.Factory.Create(this, () => Navigation.NavigateTo(RoutingConstants.Menus.DetailsForDate(DateOnly.FromDateTime(Date))))
        });
        
        AppBarService.SetActions(new AppBarAction
        {
            Icon = Icons.Material.Filled.Delete,
            Tooltip = "Usuń menu",
            Color = Color.Error,
            OnClick = EventCallback.Factory.Create(this, ConfirmAndDeleteAsync)
        });
    }
    
    private async Task ConfirmAndDeleteAsync()
    {
        await DialogService.ConfirmAndDeleteMenuAsync(
            DateOnly.FromDateTime(Date),
            (only, token) => MenusDeleter.Delete(only, token),
            Snackbar,
            Navigation,
            _cts.Token
        );
    }

    private void ItemDropped(MudItemDropInfo<MealDto> dropItem)
    {
        if (dropItem?.Item is null) return;

        // 1. Usuwamy przeciągnięty element
        _meals.Remove(dropItem.Item);

        // 2. Wyznaczamy i zabezpieczamy indeks docelowy
        var targetIndex = dropItem.IndexInZone;
        if (targetIndex < 0) targetIndex = 0;
        if (targetIndex > _meals.Count) targetIndex = _meals.Count;

        // 3. Wstawiamy go na właściwą pozycję
        _meals.Insert(targetIndex, dropItem.Item);

        // 4. Odświeżamy indeksy Order
        for (var i = 0; i < _meals.Count; i++)
        {
            _meals[i].Order = i;
        }

        _container?.Refresh();
    }

    private async Task<IEnumerable<string>> SearchRecipesAsync(string value, CancellationToken token)
    {
        if (string.IsNullOrWhiteSpace(value)) return [];
        return await FetchRecipesFromApiAsync(value, token);
    }

    private void OnMealSelected(string selectedMeal)
    {
        if (string.IsNullOrWhiteSpace(selectedMeal)) return;

        _meals.Add(new MealDto
        {
            Name = selectedMeal,
            Order = _meals.Count,
            ZoneIdentifier = "DayMenuZone"
        });

        _selectedMeal = string.Empty;
        _container?.Refresh();
    }

    private void RemoveMeal(MealDto item)
    {
        _meals.Remove(item);
        for (int i = 0; i < _meals.Count; i++)
        {
            _meals[i].Order = i;
        }
        _container?.Refresh();
    }

    private async Task SaveMenuAsync()
    {
        if (!_meals.Any())
        {
            Snackbar.Add("Dodaj co najmniej jeden posiłek!", Severity.Warning);
            return;
        }

        var orderedMeals = _meals.ToDictionary(x => x.Order, x => x.Name);
        

        var request = new UpdateMenuRequest(DateOnly.FromDateTime(Date), orderedMeals);
        var response = await MenusUpdater.Update(request, _cts.Token);
        Snackbar.Add("Pomyślnie edytowano menu!", Severity.Success);
        
        Navigation.NavigateTo(RoutingConstants.Menus.DetailsForDate(response.Date));
    }

    #region API Calls
    
    private async Task<List<MealDto>> FetchMenuForDateAsync(DateTime date)
    {
        var result = await FindMenus.Get(date, _cts.Token);
        return MealMapper.MapMeals(result?.Meals) ?? [];
    }
    
    private async Task<IEnumerable<string>> FetchRecipesFromApiAsync(string? query, CancellationToken token)
    {
        var results = await FindRecipes.Get(query, token);

        return results.Recipes.Select(x => x.Name);
    }
    #endregion

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();
    }
}