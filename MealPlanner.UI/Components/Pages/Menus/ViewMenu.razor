@page "/menus/day/{Date:datetime}"
@using MealPlanner.UI.Services
@inherits LayoutComponentBase
@inject IFindMenus FindMenus
@inject IMenuStateService MenuStateService
@inject AppBarService AppBarService
@inject NavigationManager Navigation


<MudText Typo="Typo.h5">

    Menu na dzień @Date.ToString(
                      "dddd, d MMMM yyyy",
                      _culture)

</MudText>

@if (!_meals.Any())
{
    <MudItem>
        <MudText>Brak posiłków na ten dzień</MudText>
        <MudText>Może warto coś przekąsić?</MudText>
    </MudItem>
}
else
{
    <MudList T="string">

        @foreach (var meal in _meals)
        {
            <MudListItem T="string" Value="meal">
                @meal
            </MudListItem>
        }

    </MudList>
}

@code {
    [Parameter] public DateTime Date { get; set; }

    private readonly CultureInfo _culture =
        new("pl-PL");


    private IEnumerable<string> _meals = [];

    private readonly CancellationTokenSource _cts = new();
    
    protected override async Task OnParametersSetAsync()
    {
        var menuForDay = await FindMenus.Get(Date, _cts.Token);
        if (menuForDay is not null)
        {
            _meals = menuForDay.Meals;
            AppBarService.SetActions(new AppBarAction
            {
                Icon = Icons.Material.Filled.Edit,
                Tooltip = "Edytuj menu",
                OnClick = EventCallback.Factory.Create(this, () => Navigation.NavigateTo($"/menus/edit/{Date.ToString("yyyy-MM-dd", _culture)}"))
            });
        }
        else
        {
            AppBarService.SetActions(new AppBarAction
            {
                Icon = Icons.Material.Filled.Add,
                Tooltip = "Utwórz menu",
                OnClick = EventCallback.Factory.Create(this, () => Navigation.NavigateTo($"/menus/create/{Date.ToString("yyyy-MM-dd", _culture)}"))
            });
        }
        _meals = menuForDay?.Meals ?? [];
        MenuStateService.NotifyMenuChanged();
    }

    private void OnEditMenu()
    {
        Navigation.NavigateTo(RoutingConstants.Menus.EditForDate(DateOnly.FromDateTime(Date)));
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();
    }

}