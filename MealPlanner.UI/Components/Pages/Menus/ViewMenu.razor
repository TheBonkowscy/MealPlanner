@page "/menus/day/{Date:datetime}"
@using MealPlanner.Client.Menus
@using MealPlanner.UI.Models
@using MealPlanner.UI.Services
@inherits LayoutComponentBase
@implements IDisposable
@inject IFindMenus FindMenus
@inject IDeleteMenus MenusDeleter
@inject IMenuStateService MenuStateService
@inject NavigationManager Navigation
@inject AppBarService AppBarService
@inject MealMapper MealMapper
@inject IDialogService DialogService
@inject ISnackbar Snackbar


<MudText Typo="Typo.h5">

    Menu na dzień @Date.ToString(
                      "dddd, d MMMM yyyy",
                      _culture)

</MudText>

@if (!_meals.Any())
{
    <MudItem>
        <MudText>Brak posiłków na ten dzień</MudText>
        <MudText>Może warto coś przekąsić?</MudText>
    </MudItem>
}
else
{
    <MudList T="string">

        @foreach (var meal in _meals)
        {
            <MudListItem T="string" Value="meal.Name" Href="@(RoutingConstants.Recipes.DetailsFor(meal.Id))">
                @meal.Name (Porcje: @meal.Servings)
            </MudListItem>
        }

    </MudList>
}

@code {
    [Parameter] public DateTime Date { get; set; }

    private readonly CultureInfo _culture =
        new("pl-PL");


    private List<MealDto> _meals = [];

    private readonly CancellationTokenSource _cts = new();
    
    protected override async Task OnParametersSetAsync()
    {
        var menuForDay = await FindMenus.Get(Date, _cts.Token);
        
        var formattedTitle = $"Week {ISOWeek.GetWeekOfYear(Date)} • {Date:dddd, d MMMM yyyy} • \U0001F4CB";
        AppBarService.SetTitle(formattedTitle);

        List<AppBarAction> actions = [];
        
        if (menuForDay is not null)
        {
            actions.AddRange(
            [
                new AppBarAction
                {
                    Icon = Icons.Material.Filled.Edit,
                    Tooltip = "Edytuj menu",
                    Color = Color.Inherit,
                    OnClick = EventCallback.Factory.Create(this, () => Navigation.NavigateTo(RoutingConstants.Menus.EditForDate(DateOnly.FromDateTime(Date))))
                },
                new AppBarAction
                {
                    Icon = Icons.Material.Filled.Delete,
                    Tooltip = "Usuń menu",
                    Color = Color.Error,
                    OnClick = EventCallback.Factory.Create(this, ConfirmAndDeleteAsync)
                }
            ]);
        }
        else
        {
            actions.Add(new AppBarAction
            {
                Icon = Icons.Material.Filled.Add,
                Tooltip = "Utwórz menu",
                Color = Color.Inherit,
                OnClick = EventCallback.Factory.Create(this, () => Navigation.NavigateTo(RoutingConstants.Menus.CreateForDate(DateOnly.FromDateTime(Date))))
            });
        }
        
        AppBarService.SetActions([.. actions]);
        
        _meals = MealMapper.MapMeals(menuForDay?.Meals ?? []);
        MenuStateService.NotifyMenuChanged();
    }
    
    private async Task ConfirmAndDeleteAsync()
    {
        await DialogService.ConfirmAndDeleteMenuAsync(
            DateOnly.FromDateTime(Date),
            (only, token) => MenusDeleter.Delete(only, token),
            Snackbar,
            Navigation,
            _cts.Token
        );
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();
    }

}