@page "/menus/create/{Date:datetime}"
@using MealPlanner.Client.Menus
@using MealPlanner.Client.Recipes
@using MealPlanner.Shared.Menus.Requests
@using MealPlanner.UI.Models
@using MealPlanner.UI.Models.Editors
@using MealPlanner.UI.Services
@implements IDisposable

@inject ICreateMenus CreateMenus
@inject IFindRecipes FindRecipes
@inject IMenuStateService MenuStateService
@inject AppBarService AppBarService
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject MealMapper MealMapper

<h3>@($"Tworzenie nowego menu na dzień {Date:dd.MM.yyyy}")</h3>

<MudPaper Class="pa-6 ma-4" Elevation="3">
    <MudText Typo="Typo.h5" Class="mb-4">Posiłki zaplanowane na ten dzień</MudText>

    <MudDropContainer @ref="_container"
                      T="MealDto" 
                      Items="_meals" 
                      ItemsSelector="@((item, dropzone) => item.ZoneIdentifier == dropzone)" 
                      ItemDropped="ItemDropped" 
                      Class="d-flex flex-column flex-grow-1">
        <ChildContent>
            <MudDropZone T="MealDto" 
                         Identifier="DayMenuZone" 
                         AllowReorder="true" 
                         Class="rounded mud-background-gray pa-4 min-height-200">
                <ItemRenderer>
                    <MudPaper Class="pa-3 my-2 d-flex justify-space-between align-center" Elevation="2">
                        <div class="d-flex align-center gap-3 flex-grow-1">
                            <MudIcon Icon="@Icons.Material.Filled.DragHandle" Class="mr-3 cursor-grab" />
                            <MudText Typo="Typo.body1">@context.Name</MudText>
                        </div>
                        <div class="d-flex align-center gap-3">
                            <MudNumericField @bind-Value="context.Servings"
                                             Label="Liczba porcji"
                                             Min="1"
                                             Step="1"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" 
                                           Color="Color.Error" 
                                           Size="Size.Small" 
                                           OnClick="@(() => RemoveMeal(context))" />
                        </div>
                    </MudPaper>
                </ItemRenderer>
            </MudDropZone>
        </ChildContent>
    </MudDropContainer>

    <MudPaper Class="pa-4 mt-4 mud-theme-light" Elevation="1">
        <MudText Typo="Typo.subtitle2" Class="mb-2">Dodaj nowy posiłek do menu:</MudText>
        <MudAutocomplete T="RecipeByIdDto"
                         Label="Szukaj potrawy..."
                         Value="_selectedMeal"
                         ValueChanged="OnMealSelected"
                         SearchFunc="SearchRecipesAsync"
                         ResetValueOnSelected="true"
                         AdornmentIcon="@Icons.Material.Filled.Search"
                         AdornmentColor="Color.Primary"
                         DebounceInterval="300" 
                         MinCharacters="2" />
    </MudPaper>

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Class="mt-6"
               OnClick="SaveMenuAsync">
        Utwórz menu
    </MudButton>
</MudPaper>

@code {
    [Parameter] public DateTime Date { get; set; }

    private MudDropContainer<MealDto>? _container;
    private readonly List<MealDto> _meals = [];
    private RecipeByIdDto? _selectedMeal;
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnParametersSetAsync()
    {
        _meals.Clear();
        
        var formattedTitle = $"Week {ISOWeek.GetWeekOfYear(Date)} • {Date:dddd, d MMMM yyyy} • \u002B";
        AppBarService.SetTitle(formattedTitle);
    }

    private void ItemDropped(MudItemDropInfo<MealDto> dropItem)
    {
        if (dropItem?.Item is null) return;

        // 1. Usuwamy przeciągnięty element
        _meals.Remove(dropItem.Item);

        // 2. Wyznaczamy i zabezpieczamy indeks docelowy
        var targetIndex = dropItem.IndexInZone;
        if (targetIndex < 0) targetIndex = 0;
        if (targetIndex > _meals.Count) targetIndex = _meals.Count;

        // 3. Wstawiamy go na właściwą pozycję
        _meals.Insert(targetIndex, dropItem.Item);

        // 4. Odświeżamy indeksy Order
        for (var i = 0; i < _meals.Count; i++)
        {
            _meals[i].Order = i;
        }

        _container?.Refresh();
    }
    
    private async Task<IEnumerable<RecipeByIdDto>> SearchRecipesAsync(string query, CancellationToken token) => 
        string.IsNullOrWhiteSpace(query) 
            ? [] 
            : MealMapper.MapMeals(await FindRecipes.Get(query, token));

    private void OnMealSelected(RecipeByIdDto selectedMeal)
    {
        _meals.Add(new MealDto
        {
            Id = selectedMeal.Id, 
            Name = selectedMeal.Name,
            Order = _meals.Count
        });

        _selectedMeal = null;
        _container?.Refresh();
    }

    private void RemoveMeal(MealDto item)
    {
        _meals.Remove(item);
        for (int i = 0; i < _meals.Count; i++)
        {
            _meals[i].Order = i;
        }
        _container?.Refresh();
    }

    private async Task SaveMenuAsync()
    {
        if (!_meals.Any())
        {
            Snackbar.Add("Dodaj co najmniej jeden posiłek!", Severity.Warning);
            return;
        }

        var meals = _meals.Select(x => new AddMealRequest(x.Id, x.Order + 1, x.Servings)).ToList();

        var request = new CreateMenuRequest(DateOnly.FromDateTime(Date), meals);
        var response = await CreateMenus.CreateMenu(request, _cts.Token);
        Snackbar.Add("Utworzono nowe menu!", Severity.Success);
        
        MenuStateService.NotifyMenuChanged();
        Navigation.NavigateTo(RoutingConstants.Menus.DetailsForDate(response.Date));
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();
    }
}