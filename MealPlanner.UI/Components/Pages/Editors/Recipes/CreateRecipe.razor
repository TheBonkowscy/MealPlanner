@page "/editors/recipes/create"
@using MealPlanner.UI.Services
@using MealPlanner.UI.Models.Editors
@using MealPlanner.Shared.Recipes.Requests
@using MealPlanner.Shared.Shared
@using MealPlanner.Client.Recipes
@using Microsoft.Extensions.Localization
@using MealPlanner.UI
@using System.Linq

@implements IDisposable
@inject NavigationManager Navigation
@inject IFindIngredients IngredientsFinder
@inject ICreateRecipes RecipeCreator
@inject ISnackbar Snackbar
@inject AppBarService AppBarService
@inject IStringLocalizer<Translations> L

<h3>@L[TranslationKeys.RecipeEditor.RecipeEditorCreateTitle]</h3>

<MudPaper Class="pa-6 ma-4" Elevation="3">
    <MudTextField @bind-Value="_recipeName"
                  Label="@L[TranslationKeys.RecipeEditor.RecipeCreatorNameTextField]"
                  Variant="Variant.Outlined"
                  Class="mb-6"
                  Required="true"
                  RequiredError="@L[TranslationKeys.RecipeEditor.RecipeCreatorValidationNameError]" />
    <MudNumericField @bind-Value="_servings"
                  Label="@L[TranslationKeys.RecipeEditor.RecipeCreatorServingsTextField]"
                  Variant="Variant.Outlined"
                  Class="mb-6"
                  Required="true"
                  Min="1"
                  RequiredError="@L[TranslationKeys.RecipeEditor.RecipeCreatorServingsRequiredError]" />

    <MudText Typo="Typo.h6" Class="mb-2">@L[TranslationKeys.RecipeEditor.RecipeCreatorIngredientsSectionTitle]</MudText>
    
    <MudDropContainer @ref="_ingredientsContainer"
                      T="IngredientDto"
                      Items="_ingredients"
                      ItemsSelector="@((item, dropzone) => item.ZoneIdentifier == dropzone)"
                      ItemDropped="IngredientDropped"
                      Class="d-flex flex-column mb-4">
        <ChildContent>
            <MudDropZone T="IngredientDto"
                         Identifier="IngredientsZone"
                         AllowReorder="true"
                         Class="rounded mud-background-gray pa-3 min-height-100">
                <ItemRenderer>
                    <MudPaper Class="pa-3 my-2 d-flex align-center gap-4" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.DragHandle" Class="cursor-grab" />

                        <MudAutocomplete T="PredefinedProductDto"
                                         Label="@L[TranslationKeys.RecipeEditor.RecipeCreatorIngredientsSearchTitle]"
                                         Value="@context.SelectedProduct"
                                         ValueChanged="@(product => OnProductChanged(context, product))"
                                         SearchFunc="SearchIngredientsAsync"
                                         ToStringFunc="@(p => p?.Name)"
                                         ResetValueOnSelected="false"
                                         CoerceText="true"
                                         AdornmentIcon="@Icons.Material.Filled.Search"
                                         AdornmentColor="Color.Primary"
                                         Dense="true"
                                         Margin="Margin.Dense"
                                         Variant="Variant.Outlined"
                                         DebounceInterval="200"
                                         MinCharacters="0" />

                        <MudNumericField @bind-Value="context.Quantity"
                                         Label="@L[TranslationKeys.RecipeEditor.RecipeCreatorIngredientsQuantityTitle]"
                                         Min="0.01m"
                                         Step="0.1m"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />

                        <MudSelect T="MeasureUnitDto"
                                   Label="@L[TranslationKeys.RecipeEditor.RecipeCreatorIngredientsUnitTitle]"
                                   Value="@context.SelectedUnit"
                                   ValueChanged="@(unit => OnUnitChanged(context, unit))"
                                   ToStringFunc="@(u => u?.DisplayName)"
                                   Disabled="@(!GetAvailableUnits(context).Any())"
                                   Variant="Variant.Outlined"
                                   Margin="Margin.Dense"
                                   Dense="true">
                            @foreach (var unit in GetAvailableUnits(context))
                            {
                                <MudSelectItem Value="@unit">@unit.DisplayName</MudSelectItem>
                            }
                        </MudSelect>

                        <MudSpacer />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveIngredient(context))" />
                    </MudPaper>
                </ItemRenderer>
            </MudDropZone>
        </ChildContent>
    </MudDropContainer>

    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Secondary"
               Variant="Variant.Outlined"
               OnClick="AddIngredient"
               Class="mb-6">
        @L[TranslationKeys.RecipeEditor.RecipeCreatorIngredientsAddButtonTitle]
    </MudButton>

    <MudDivider Class="my-4" />

    <MudText Typo="Typo.h6" Class="mb-2">@L[TranslationKeys.RecipeEditor.RecipeCreatorRecipeStepsSectionTitle]</MudText>

    <MudDropContainer @ref="_stepsContainer"
                      T="StepDto"
                      Items="_steps"
                      ItemsSelector="@((item, dropzone) => item.ZoneIdentifier == dropzone)"
                      ItemDropped="StepDropped"
                      Class="d-flex flex-column mb-4">
        <ChildContent>
            <MudDropZone T="StepDto"
                         Identifier="StepsZone"
                         AllowReorder="true"
                         Class="rounded mud-background-gray pa-3 min-height-100">
                <ItemRenderer>
                    <MudPaper Class="pa-3 my-2 d-flex align-center gap-4" Elevation="2">
                        <MudIcon Icon="@Icons.Material.Filled.DragHandle" Class="cursor-grab" />
                        
                        <MudChip T="string" Color="Color.Primary" Size="Size.Small">Krok @(context.Order + 1)</MudChip>

                        <MudTextField @bind-Value="context.Instructions"
                                      Label="@L[TranslationKeys.RecipeEditor.RecipeCreatorRecipeStepsInstructionTitle]"
                                      Lines="2"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Class="flex-grow-1" />

                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => RemoveStep(context))" />
                    </MudPaper>
                </ItemRenderer>
            </MudDropZone>
        </ChildContent>
    </MudDropContainer>

    <MudButton StartIcon="@Icons.Material.Filled.Add"
               Color="Color.Secondary"
               Variant="Variant.Outlined"
               OnClick="AddStep"
               Class="mb-6">
        @L[TranslationKeys.RecipeEditor.RecipeCreatorRecipeStepsAddButtonTitle]
    </MudButton>

    <MudDivider Class="my-4" />

    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Add"
               Size="Size.Large"
               Class="mt-2"
               OnClick="SaveRecipeAsync">
        @L[TranslationKeys.RecipeEditor.RecipeCreatorCreateRecipeButtonTitle]
    </MudButton>
</MudPaper>

@code {
    private string _recipeName = string.Empty;
    private int _servings = 1;
    
    private MudDropContainer<IngredientDto>? _ingredientsContainer;
    private readonly List<IngredientDto> _ingredients = [];

    private MudDropContainer<StepDto>? _stepsContainer;
    private readonly List<StepDto> _steps = [];

    private List<PredefinedProductDto> _predefinedProducts = [];
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        AppBarService.SetTitle(L[TranslationKeys.RecipeEditor.RecipeCreatorApplicationTitle]);
        await LoadPredefinedProductsAsync();
    }

    private async Task LoadPredefinedProductsAsync()
    {
        var response = await IngredientsFinder.Get(_cts.Token);
        _predefinedProducts =
        [
            .. response.Ingredients.Select(i => new PredefinedProductDto(i.Id,
                i.Name,
                [.. i.ApplicableUnits]))
        ];
    }

    private void AddIngredient()
    {
        _ingredients.Add(new IngredientDto());
        _ingredientsContainer?.Refresh();
    }
    
    private IEnumerable<MeasureUnitDto> GetAvailableUnits(IngredientDto currentItem)
    {
        if (currentItem.SelectedProduct == null)
            return [];

        var usedUnitValuesInOtherRows = _ingredients
            .Where(i => i != currentItem && i.SelectedProduct?.Id == currentItem.SelectedProduct.Id)
            .Select(i => i.SelectedUnit?.UnderlyingValue)
            .Where(val => val != null)
            .ToHashSet();

        return currentItem.AvailableUnits
            .Where(u => !usedUnitValuesInOtherRows.Contains(u.UnderlyingValue));
    }

    private void OnProductChanged(IngredientDto item, PredefinedProductDto? product)
    {
        item.SelectedProduct = product;
        item.Id = product?.Id ?? 0;
    
        item.SelectedUnit = GetAvailableUnits(item).FirstOrDefault();
    
        _ingredientsContainer?.Refresh();
    }
    
    private void OnUnitChanged(IngredientDto item, MeasureUnitDto? unit)
    {
        item.SelectedUnit = unit;
    
        _ingredientsContainer?.Refresh();
    }

    private void RemoveIngredient(IngredientDto item)
    {
        _ingredients.Remove(item);
        _ingredientsContainer?.Refresh();
    }

    private void IngredientDropped(MudItemDropInfo<IngredientDto> dropItem)
    {
        if (dropItem.Item is null) return;

        _ingredients.Remove(dropItem.Item);
        var targetIndex = Math.Clamp(dropItem.IndexInZone, 0, _ingredients.Count);
        _ingredients.Insert(targetIndex, dropItem.Item);
        
        _ingredientsContainer?.Refresh();
    }

    private void AddStep()
    {
        _steps.Add(new StepDto
        {
            Order = _steps.Count,
            Instructions = string.Empty
        });
        _stepsContainer?.Refresh();
    }

    private void RemoveStep(StepDto item)
    {
        _steps.Remove(item);
        ReindexSteps();
        _stepsContainer?.Refresh();
    }

    private void StepDropped(MudItemDropInfo<StepDto> dropItem)
    {
        if (dropItem?.Item is null) return;

        _steps.Remove(dropItem.Item);
        var targetIndex = Math.Clamp(dropItem.IndexInZone, 0, _steps.Count);
        _steps.Insert(targetIndex, dropItem.Item);

        ReindexSteps();
        _stepsContainer?.Refresh();
    }

    private void ReindexSteps()
    {
        for (int i = 0; i < _steps.Count; i++)
        {
            _steps[i].Order = i;
        }
    }

    private async Task SaveRecipeAsync()
    {
        if (string.IsNullOrWhiteSpace(_recipeName))
        {
            Snackbar.Add(L[TranslationKeys.RecipeEditor.RecipeCreatorValidationNameError], Severity.Warning);
            return;
        }

        if (!_ingredients.Any() || _ingredients.Any(i => i.SelectedProduct == null || i.SelectedUnit == null))
        {
            Snackbar.Add(L[TranslationKeys.RecipeEditor.RecipeCreatorValidationIngredientsError], Severity.Warning);
            return;
        }

        if (!_steps.Any() || _steps.Any(s => string.IsNullOrWhiteSpace(s.Instructions)))
        {
            Snackbar.Add(L[TranslationKeys.RecipeEditor.RecipeCreatorValidationStepsError], Severity.Warning);
            return;
        }

        var finalIngredients = _ingredients.Select(i => 
                new AddIngredientRequest(i.Id, 
                    i.Quantity, 
                    i.SelectedUnit!.UnderlyingValue)).ToList();

        var finalSteps = _steps.Select(s => 
            new AddRecipeStepRequest(s.Order + 1, s.Instructions)
        ).ToList();

        var request = new CreateRecipeRequest(_recipeName, _servings, finalIngredients, finalSteps);
        var response = await RecipeCreator.CreateRecipe(request, _cts.Token);
        if (response.IsSuccess)
        {
            Snackbar.Add(L[TranslationKeys.RecipeEditor.RecipeCreatorRecipeAddedConfirmation], Severity.Success);
            Navigation.NavigateTo(RoutingConstants.Recipes.DetailsFor(response.Value!.Id));
        }
        else
        {
            Snackbar.Add(response.Error!.Message, Severity.Error);
        }
    }

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
        AppBarService.ClearActions();
    }

    private Task<IEnumerable<PredefinedProductDto>> SearchIngredientsAsync(string value, CancellationToken arg2)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult<IEnumerable<PredefinedProductDto>>([.. _predefinedProducts.Take(20)]);
        }

        return Task.FromResult<IEnumerable<PredefinedProductDto>>([
            .. _predefinedProducts
                .Where(p => p.Name.Contains(value, StringComparison.OrdinalIgnoreCase))
                .Take(20)
        ]);
    }
}