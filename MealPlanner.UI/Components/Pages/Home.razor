@page "/"
@using Microsoft.Extensions.Localization

@inject IStringLocalizer<Translations> L

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

Welcome to your new app.

@{
    var localizedResult = L[TranslationKeys.NavMenu.NavMenuDashboardName];
}
<p>Wartość: @localizedResult</p>
<p>Czy nie znaleziono?: @localizedResult.ResourceNotFound</p>
<p>Aktualna kultura UI: @System.Globalization.CultureInfo.CurrentUICulture.Name</p>