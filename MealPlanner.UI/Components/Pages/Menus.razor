@page "/menus"
@using MealPlanner.Client
@using MealPlanner.Shared.Menus.Responses
@implements IDisposable
@inject IMenuClient MenuClient;

@if (_menu == null)
{
    <p>
        <em>There is no menu for @_selectedDate?.ToLongDateString()</em>
        <p>Maybe you shouldn't go hungry all the time, huh?</p>
    </p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Meal name</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var meal in _menu.Meals)
        {
            <tr>
                <td>@meal</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {

    private DateTime? _selectedDate = DateTime.Today;
    
    private GetMenuResponse? _menu;
    
    private readonly CancellationTokenSource _cts = new();

    protected override async Task OnInitializedAsync()
    {
        _selectedDate ??= DateTime.Today;

        _menu = await MenuClient.Get(_selectedDate.Value, _cts.Token);
    }
    
    // TODO: Next - "let's add a plus button and a form to be submitted. Propose where and how to put the icon for the navigation."

    public void Dispose()
    {
        _cts.Cancel();
        _cts.Dispose();
    }
}